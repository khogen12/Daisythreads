# Copy this file to .env and fill it in
STORE_NAME=Daisy Threads
ADMIN_PASSWORD=change-this-to-a-long-password
SECRET=type-any-long-random-text-here
WHATSAPP=919876543210
INSTAGRAM=daisythreads.store
UPI_ID=yourname@upi
COUPON_CODE=DAISY10
COUPON_PERCENT=10
# Cash on delivery: customer pays this advance by UPI first (leave empty or 0 to turn off)
COD_ADVANCE=50
PORT=3000

# Email (optional). Gmail: turn on 2-step verification, then create an "App password"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
OWNER_EMAIL=

# Only when hosting: folder of a persistent disk/volume (e.g. /data). Leave empty on your computer.
DATA_DIR=
